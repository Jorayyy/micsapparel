# Copy to .env.local (or set in Vercel project settings) and change the values.

# Required in production. Admin password for /admin.
# In development only, falls back to "micsapparel2024" if unset.
ADMIN_PASSWORD=

# Optional. Secret used to sign admin session cookies.
# Derived from ADMIN_PASSWORD when unset.
ADMIN_SESSION_SECRET=

# Canonical site URL used for SEO (metadata, sitemap, robots, canonical).
NEXT_PUBLIC_SITE_URL=https://micsapparel.com

# Optional. Directory for the file-backed data store (orders, admin edits, uploads).
# Defaults to ./.data
# DATA_DIR=
